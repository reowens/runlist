        },
        "by": {
          "$ref": "#/$defs/actor"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,3})?Z$"
        },
        "method": {
          "enum": [
            "manual",
            "check",
            "test"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(evidence):[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      },
      "required": [
        "id",
        "by",
        "at",
        "method",
        "reason",
        "evidence_ids"
      ],
      "additionalProperties": true
    },
    "flagData": {
      "allOf": [
        {
          "$ref": "#/$defs/commonData"
        },
        {
          "type": "object",
          "properties": {
            "severity": {
              "enum": [
                "problem",
                "warn",
                "info"
              ]
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "occurrence": {
              "type": "integer",
              "minimum": 1
            },
            "triage": {
              "$ref": "#/$defs/triage"
            },
            "resolutions": {
              "type": "array",
              "items": {
