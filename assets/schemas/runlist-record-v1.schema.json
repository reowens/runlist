          "minLength": 1,
          "pattern": "\\S"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(evidence):[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "supersedes_ruling_id": {
          "type": "string",
          "pattern": "^(ruling):[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "id",
        "by",
        "at",
        "kind",
        "reason",
        "authority",
        "evidence_ids"
