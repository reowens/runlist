      ],
      "additionalProperties": true
    },
    "option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(option):[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "consequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consequence"
          }
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "consequences"
      ],
      "additionalProperties": true
    },
    "authority": {
      "type": "object",
      "properties": {
        "basis": {
          "enum": [
            "human",
            "delegated"
          ]
        },
        "grant_ref": {
          "$ref": "#/$defs/target"
        }
      },
      "required": [
        "basis"
      ],
      "additionalProperties": true
    },
    "ruling": {
      "type": "object",
      "properties": {
